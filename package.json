{
  "name": "chocolate-ads",
  "version": "1.0.0",
  "private": true,
  "description": "Publicités chocolat ASSEL (20 s) et EBCORE (10 s) : compositing 2,5D de photos réelles et 3D Three.js, bande-son synthétisée, export MP4 9:16 et 16:9.",
  "type": "module",
  "scripts": {
    "preview": "node tools/serve.mjs",
    "render": "node tools/render.mjs",
    "render:vertical": "node tools/render.mjs --format 9x16",
    "render:horizontal": "node tools/render.mjs --format 16x9",
    "render:ebcore": "node tools/render.mjs --film ebcore"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BijouterieMerouani/Pub.git"
  },
  "dependencies": {
    "playwright-core": "^1.48.2",
    "three": "^0.169.0"
  }
}
